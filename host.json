{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Fhn.Originate.FtbanknewSync": "Information",
      "Host.Aggregator": "Warning"
    }
  },
  "functionTimeout": "00:30:00",
  "extensions": {
    "blobs": {
      "maxDegreeOfParallelism": 1
    },
    "queues": {
      "maxDequeueCount": 5
    }
  }
}
